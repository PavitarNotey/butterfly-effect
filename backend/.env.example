# Backend only. Keep .env ignored. No network calls on startup.
AI_PROVIDER=auto
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_API_KEY=
# Explicit offline development/CI: AI_PROVIDER=mock
AI_TIMEOUT_SECONDS=35
AI_MAX_RETRIES=1
AI_MAX_OUTPUT_TOKENS=3500
AI_MOMENT_OUTPUT_TOKENS=1400
AI_RECAP_OUTPUT_TOKENS=1600
AI_COMMENTARY_OUTPUT_TOKENS=3500
AI_MAX_INPUT_BYTES=64000
# Paid generation is OFF by default. Mock does not require paid enable/prices.
AI_PAID_GENERATION_ENABLED=false
AI_CONCURRENCY=2
AI_REQUESTS_PER_MINUTE=12
AI_CALLS_PER_HOUR=40
AI_CALLS_PER_LIFETIME=12
AI_ESTIMATED_BUDGET_USD=0.25
AI_CACHE_ENTRIES=128
AI_CACHE_TTL_SECONDS=3600
# Approximate estimates only; configure current deployment prices per 1M tokens.
# Both prices must be positive before paid generation is allowed.
# Zero means UNCONFIGURED, never free. Obtain rates for your deployment in Azure.
# Counters are process-local: restart/multiple workers reset or multiply them.
# This is estimated application protection, not an Azure billing cap.
# See docs/PHASE_4C_PRODUCT_HARDENING.md before enabling paid requests.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
